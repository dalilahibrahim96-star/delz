<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Affiliate AI Command Center</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#fdf4f8', 100: '#fbe8f1', 500: '#ec4899', 600: '#db2777', 700: '#be185d' }
                    }
                }
            }
        }
    </script>
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col" x-data="appData()" x-init="init()">

    <!-- TOP APP BAR -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="bg-pink-600 p-2 rounded-xl text-white font-black text-xl shadow-lg shadow-pink-600/30">⚡</div>
            <div>
                <h1 class="font-extrabold text-lg tracking-wide text-white flex items-center gap-2">
                    AFFILIATE AI <span class="text-xs bg-pink-600 text-white px-2 py-0.5 rounded-full font-medium">COMMAND CENTER</span>
                </h1>
                <p class="text-xs text-slate-400 italic">"Aku bagi produk. AI buat kerja."</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button @click="currentTab = 'settings'" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 relative transition">
                <i data-lucide="settings" class="w-5 h-5"></i>
                <span x-show="!apiKey" class="absolute top-1 right-1 w-2.5 h-2.5 bg-amber-500 rounded-full animate-ping"></span>
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 pb-24">

        <!-- TAB: DASHBOARD -->
        <div x-show="currentTab === 'dashboard'" x-cloak class="space-y-6">
            <!-- HERO BANNER -->
            <div class="bg-gradient-to-r from-pink-900/40 via-purple-900/30 to-slate-900 border border-pink-500/20 rounded-2xl p-6 shadow-xl relative overflow-hidden">
                <div class="relative z-10">
                    <span class="text-xs font-semibold uppercase tracking-wider text-pink-400 bg-pink-950/60 px-3 py-1 rounded-full border border-pink-800/50">TikTok Affiliate AI Team</span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white mt-3">Ready to dominate TikTok today?</h2>
                    <p class="text-sm text-slate-300 mt-1 max-w-xl">Upload your product, pick a character, and let your AI command center generate high-converting Malaysian Malay scripts, hooks, and Veo prompts instantly.</p>
                    <div class="mt-5 flex flex-wrap gap-3">
                        <button @click="currentTab = 'lazymode'" class="bg-pink-600 hover:bg-pink-500 text-white font-bold px-5 py-2.5 rounded-xl shadow-lg shadow-pink-600/30 flex items-center gap-2 transition transform active:scale-95">
                            <i data-lucide="zap" class="w-4 h-4"></i> Start Lazy Mode
                        </button>
                        <button @click="currentTab = 'videofactory'" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold px-4 py-2.5 rounded-xl border border-slate-700 flex items-center gap-2 transition">
                            <i data-lucide="clapperboard" class="w-4 h-4"></i> Video Factory
                        </button>
                    </div>
                </div>
            </div>

            <!-- MODULE GRID -->
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 px-1">Command Modules</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <template x-for="mod in modules">
                    <div @click="currentTab = mod.id" class="bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-pink-500/40 rounded-2xl p-4 cursor-pointer transition group flex flex-col justify-between shadow-md">
                        <div>
                            <div class="w-10 h-10 rounded-xl bg-slate-800 text-pink-400 group-hover:bg-pink-600 group-hover:text-white flex items-center justify-center transition mb-3">
                                <i :data-lucide="mod.icon" class="w-5 h-5"></i>
                            </div>
                            <h4 class="font-bold text-slate-200 text-sm group-hover:text-pink-400 transition" x-text="mod.name"></h4>
                            <p class="text-xs text-slate-400 mt-1 leading-relaxed" x-text="mod.desc"></p>
                        </div>
                        <div class="mt-4 flex items-center text-xs font-semibold text-pink-500 group-hover:translate-x-1 transition duration-200">
                            Open <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB: LAZY MODE -->
        <div x-show="currentTab === 'lazymode'" x-cloak class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="bg-pink-600/20 text-pink-500 p-2.5 rounded-xl">
                        <i data-lucide="zap" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Lazy Mode</h2>
                        <p class="text-xs text-slate-400">Upload product + name. AI does everything else automatically.</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Name</label>
                        <input type="text" x-model="lazyForm.name" placeholder="e.g. Lipmatte Matte Magic Code 04" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Image (Optional)</label>
                        <div class="border-2 border-dashed border-slate-800 hover:border-pink-500/50 rounded-xl p-4 text-center cursor-pointer bg-slate-950 transition" @click="$refs.lazyImageInput.click()">
                            <template x-if="!lazyForm.imagePreview">
                                <div class="py-3">
                                    <i data-lucide="image-plus" class="w-8 h-8 mx-auto text-slate-500 mb-2"></i>
                                    <p class="text-xs text-slate-400">Click to upload product photo</p>
                                </div>
                            </template>
                            <template x-if="lazyForm.imagePreview">
                                <div class="relative inline-block">
                                    <img :src="lazyForm.imagePreview" class="h-32 rounded-lg object-contain mx-auto">
                                    <button @click.stop="lazyForm.imagePreview = ''; lazyForm.imageBase64 = ''" class="absolute -top-2 -right-2 bg-red-600 text-white rounded-full p-1 text-xs">
                                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </template>
                        </div>
                        <input type="file" x-ref="lazyImageInput" class="hidden" accept="image/*" @change="handleImageUpload($event, 'lazy')">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Malay Style</label>
                            <select x-model="lazyForm.malayStyle" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                                <option value="Casual Malaysian Malay">Casual Malaysian Malay</option>
                                <option value="KL Slang / Rempit Casual">KL Slang</option>
                                <option value="Kelantan Slang">Kelantan Slang</option>
                                <option value="Mixed Malay-English (Manglish)">Manglish</option>
                                <option value="Gen Z TikTok Style">Gen Z TikTok Style</option>
                                <option value="Deadpan / Sarcastic">Deadpan / Sarcastic</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Video Style</label>
                            <select x-model="lazyForm.videoStyle" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                                <option value="Problem-Solution">Problem-Solution</option>
                                <option value="Relatable Daily Life">Relatable Daily Life</option>
                                <option value="POV">POV</option>
                                <option value="Malaysian Comedy Skit">Malaysian Comedy Skit</option>
                                <option value="UGC Review">UGC Review</option>
                                <option value="Before/After">Before/After</option>
                            </select>
                        </div>
                    </div>

                    <button @click="runLazyMode()" :disabled="isGenerating || !lazyForm.name" class="w-full bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-pink-600/30 flex items-center justify-center gap-2 transition disabled:opacity-50">
                        <template x-if="!isGenerating">
                            <span class="flex items-center gap-2"><i data-lucide="sparkles" class="w-5 h-5"></i> 🔥 MAKE CONTENT (AI AUTO-PILOT)</span>
                        </template>
                        <template x-if="isGenerating">
                            <span class="flex items-center gap-2 animate-pulse"><i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> AI is crafting your masterpiece...</span>
                        </template>
                    </button>
                </div>
            </div>

            <!-- LAZY RESULTS DISPLAY -->
            <template x-if="lazyResult">
                <div class="space-y-4" x-transition>
                    <div class="flex items-center justify-between bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                        <div>
                            <span class="text-xs font-bold text-pink-400 uppercase tracking-wider">YOUR LAZY CONTENT IS READY 😎</span>
                            <h3 class="text-lg font-bold text-white mt-0.5" x-text="lazyResult.productName"></h3>
                        </div>
                        <button @click="copyAllContent(lazyResult)" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold px-3 py-2 rounded-xl flex items-center gap-1.5 transition">
                            <i data-lucide="copy" class="w-4 h-4"></i> Copy All
                        </button>
                    </div>

                    <!-- STRATEGY CARD -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                            <i data-lucide="target" class="w-4 h-4 text-pink-500"></i> AI Strategy & Product Lock
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                                <span class="text-slate-400 block font-semibold mb-1">Target Audience:</span>
                                <span class="text-slate-200" x-text="lazyResult.strategy.audience"></span>
                            </div>
                            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                                <span class="text-slate-400 block font-semibold mb-1">Core Problem Solved:</span>
                                <span class="text-slate-200" x-text="lazyResult.strategy.problem"></span>
                            </div>
                            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                                <span class="text-slate-400 block font-semibold mb-1">Strongest Benefit:</span>
                                <span class="text-slate-200" x-text="lazyResult.strategy.benefit"></span>
                            </div>
                            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80">
                                <span class="text-slate-400 block font-semibold mb-1">Product Lock (Color/Specs):</span>
                                <span class="text-slate-200 font-mono text-[11px]" x-text="lazyResult.productLock"></span>
                            </div>
                        </div>
                    </div>

                    <!-- HOOK & SCRIPT -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                                <i data-lucide="clapperboard" class="w-4 h-4 text-pink-500"></i> Scroll-Stopping Hook & Script
                            </h4>
                            <button @click="copyText(lazyResult.hook + '\n\n' + lazyResult.script)" class="text-xs text-pink-400 hover:underline flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy Script
                            </button>
                        </div>
                        <div class="bg-slate-950 p-3.5 rounded-xl border border-pink-500/30">
                            <span class="text-[10px] bg-pink-950 text-pink-400 px-2 py-0.5 rounded font-bold uppercase tracking-wider">Scroll-Stopping Hook</span>
                            <p class="text-sm font-bold text-white mt-1.5" x-text="lazyResult.hook"></p>
                        </div>
                        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
                            <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-bold uppercase tracking-wider">Dialogue & Action Script</span>
                            <div class="text-sm text-slate-200 mt-2 whitespace-pre-line leading-relaxed" x-text="lazyResult.script"></div>
                        </div>
                    </div>

                    <!-- VEO PROMPT -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                                <i data-lucide="video" class="w-4 h-4 text-pink-500"></i> Veo / AI Video Prompt (9:16)
                            </h4>
                            <button @click="copyText(lazyResult.veoPrompt)" class="text-xs text-pink-400 hover:underline flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy Prompt
                            </button>
                        </div>
                        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 font-mono text-xs text-slate-300 leading-relaxed" x-text="lazyResult.veoPrompt"></div>
                    </div>

                    <!-- CAPTION & CTA -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                                <i data-lucide="message-square" class="w-4 h-4 text-pink-500"></i> Caption, CTA & Hashtags
                            </h4>
                            <button @click="copyText(lazyResult.caption + '\n\n' + lazyResult.hashtags)" class="text-xs text-pink-400 hover:underline flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy Caption
                            </button>
                        </div>
                        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 text-xs text-slate-200 space-y-2">
                            <p x-text="lazyResult.caption"></p>
                            <p class="text-pink-400 font-medium" x-text="lazyResult.hashtags"></p>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- TAB: VIDEO FACTORY -->
        <div x-show="currentTab === 'videofactory'" x-cloak class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-pink-600/20 text-pink-500 p-2.5 rounded-xl">
                        <i data-lucide="clapperboard" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Video Factory</h2>
                        <p class="text-xs text-slate-400">Generate tailored scripts and shot breakdowns.</p>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Name & Key Detail</label>
                    <input type="text" x-model="factoryForm.product" placeholder="e.g. Minyak Wangi Viral Kasturi Kijang" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Duration</label>
                        <select x-model="factoryForm.duration" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                            <option value="8 seconds">8 Seconds (Fast Hook)</option>
                            <option value="15 seconds">15 Seconds (Standard TikTok)</option>
                            <option value="30 seconds">30 Seconds (Storytelling)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Style</label>
                        <select x-model="factoryForm.style" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                            <option value="Malaysian Comedy Skit">Malaysian Comedy Skit</option>
                            <option value="Problem-Solution">Problem-Solution</option>
                            <option value="POV Daily Life">POV Daily Life</option>
                            <option value="Soft-Sell Story">Soft-Sell Story</option>
                            <option value="Cinematic UGC">Cinematic UGC</option>
                        </select>
                    </div>
                </div>
                <button @click="runVideoFactory()" :disabled="isGenerating || !factoryForm.product" class="w-full bg-pink-600 hover:bg-pink-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-pink-600/30 flex items-center justify-center gap-2 transition disabled:opacity-50">
                    <span x-show="!isGenerating">Generate Concept & Script</span>
                    <span x-show="isGenerating" class="animate-pulse">Building concept...</span>
                </button>
            </div>
            
            <template x-if="factoryResult">
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-4" x-transition>
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-pink-400 uppercase tracking-wider" x-text="factoryResult.title"></h3>
                        <button @click="copyText(factoryResult.fullText)" class="text-xs text-slate-300 hover:text-white bg-slate-800 px-3 py-1.5 rounded-lg flex items-center gap-1">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy
                        </button>
                    </div>
                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-sm text-slate-200 whitespace-pre-line leading-relaxed" x-text="factoryResult.fullText"></div>
                </div>
            </template>
        </div>

        <!-- TAB: HOOK LAB -->
        <div x-show="currentTab === 'hooklab'" x-cloak class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-pink-600/20 text-pink-500 p-2.5 rounded-xl">
                        <i data-lucide="anchor" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Hook Lab</h2>
                        <p class="text-xs text-slate-400">Generate 10 scroll-stopping Malaysian hooks with Stop-Scores.</p>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Name / Topic</label>
                    <input type="text" x-model="hookProduct" placeholder="e.g. Botol Air Insulated 2 Liter" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                </div>
                <button @click="runHookLab()" :disabled="isGenerating || !hookProduct" class="w-full bg-pink-600 hover:bg-pink-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-pink-600/30 flex items-center justify-center gap-2 transition disabled:opacity-50">
                    <span x-show="!isGenerating">Generate 10 Hooks</span>
                    <span x-show="isGenerating" class="animate-pulse">Generating hooks...</span>
                </button>
            </div>

            <template x-if="hookResults.length > 0">
                <div class="space-y-3" x-transition>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 px-1">Top Hooks Generated</h3>
                    <template x-for="hook in hookResults">
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl flex items-center justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-[10px] bg-pink-950 text-pink-400 px-2 py-0.5 rounded font-bold uppercase" x-text="hook.category"></span>
                                    <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-mono font-bold" x-text="'Score: ' + hook.score + '/10'"></span>
                                </div>
                                <p class="text-sm font-bold text-white" x-text="hook.text"></p>
                            </div>
                            <button @click="copyText(hook.text)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 rounded-lg shrink-0">
                                <i data-lucide="copy" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </template>
                </div>
            </template>
        </div>

        <!-- TAB: ANGLE MACHINE -->
        <div x-show="currentTab === 'anglemachine'" x-cloak class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-pink-600/20 text-pink-500 p-2.5 rounded-xl">
                        <i data-lucide="compass" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Angle Machine</h2>
                        <p class="text-xs text-slate-400">Find 10 distinct content angles for the exact same product.</p>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Name & Details</label>
                    <input type="text" x-model="angleProduct" placeholder="e.g. Kain Pelikat Cotton Lembut" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
                </div>
                <button @click="runAngleMachine()" :disabled="isGenerating || !angleProduct" class="w-full bg-pink-600 hover:bg-pink-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-pink-600/30 flex items-center justify-center gap-2 transition disabled:opacity-50">
                    <span x-show="!isGenerating">Generate 10 Unique Angles</span>
                    <span x-show="isGenerating" class="animate-pulse">Finding angles...</span>
                </button>
            </div>

            <template x-if="angleResults.length > 0">
                <div class="space-y-3" x-transition>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 px-1">10 Unique Selling Angles</h3>
                    <template x-for="angle in angleResults">
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-bold text-pink-400 uppercase" x-text="angle.title"></span>
                                <button @click="copyText(angle.title + ': ' + angle.concept)" class="text-xs text-slate-400 hover:text-white flex items-center gap-1">
                                    <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy
                                </button>
                            </div>
                            <p class="text-sm text-slate-200" x-text="angle.concept"></p>
                        </div>
                    </template>
                </div>
            </template>
        </div>

        <!-- TAB: PRODUCT VAULT -->
        <div x-show="currentTab === 'productvault'" x-cloak class="space-y-6">
            <div class="flex items-center justify-between bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <div>
                    <h2 class="text-lg font-bold text-white">Product Vault</h2>
                    <p class="text-xs text-slate-400">Saved products and Product Locks stored securely in browser.</p>
                </div>
                <button @click="openNewProductModal = true" class="bg-pink-600 hover:bg-pink-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl flex items-center gap-1.5 shadow-lg shadow-pink-600/30">
                    <i data-lucide="plus" class="w-4 h-4"></i> Add Product
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <template x-for="prod in savedProducts">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3 flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between">
                                <h3 class="font-bold text-white text-sm" x-text="prod.name"></h3>
                                <button @click="deleteProduct(prod.id)" class="text-slate-500 hover:text-red-400"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                            </div>
                            <p class="text-xs text-slate-400 mt-1 font-mono bg-slate-950 p-2 rounded-lg border border-slate-800/80" x-text="'LOCK: ' + prod.lock"></p>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
                            <span class="text-[10px] text-slate-500" x-text="prod.date"></span>
                            <button @click="loadIntoLazy(prod)" class="text-xs text-pink-400 hover:underline font-semibold flex items-center gap-1">
                                Use in Lazy Mode <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </template>
                <template x-if="savedProducts.length === 0">
                    <div class="col-span-full bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center text-slate-500">
                        <i data-lucide="package" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
                        <p class="text-sm">No products saved in vault yet.</p>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB: SETTINGS -->
        <div x-show="currentTab === 'settings'" x-cloak class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-lg">
                <div class="flex items-center space-x-3">
                    <div class="bg-pink-600/20 text-pink-500 p-2.5 rounded-xl">
                        <i data-lucide="key" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-white">Gemini API Key</h2>
                        <p class="text-xs text-slate-400">Enter your free Gemini API key. Stored locally in your browser only.</p>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">API Key</label>
                    <input type="password" x-model="apiKey" placeholder="AIzaSy..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-pink-500 font-mono">
                </div>

                <button @click="saveSettings()" class="w-full bg-pink-600 hover:bg-pink-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-pink-600/30 transition">
                    Save API Key
                </button>

                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs text-slate-400 space-y-2">
                    <p class="font-bold text-slate-300">💡 How to get a free Gemini API Key:</p>
                    <ol class="list-decimal list-inside space-y-1">
                        <li>Go to <a href="https://aistudio.google.com/" target="_blank" class="text-pink-400 underline">Google AI Studio</a>.</li>
                        <li>Sign in with any Google account.</li>
                        <li>Click "Get API key" and create a free key in seconds.</li>
                    </ol>
                </div>
            </div>
        </div>

    </main>

    <!-- BOTTOM NAVIGATION BAR -->
    <nav class="bg-slate-900 border-t border-slate-800 fixed bottom-0 left-0 right-0 z-40 px-2 py-2 flex justify-around items-center max-w-4xl mx-auto">
        <template x-for="nav in navItems">
            <button @click="currentTab = nav.id" :class="currentTab === nav.id ? 'text-pink-500 bg-pink-950/40 border border-pink-500/20' : 'text-slate-400 hover:text-slate-200'" class="flex flex-col items-center py-1.5 px-3 rounded-xl transition text-xs font-medium">
                <i :data-lucide="nav.icon" class="w-5 h-5 mb-0.5"></i>
                <span x-text="nav.name"></span>
            </button>
        </template>
    </nav>

    <!-- NEW PRODUCT MODAL -->
    <div x-show="openNewProductModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 max-w-md w-full space-y-4">
            <h3 class="text-lg font-bold text-white">Add Product to Vault</h3>
            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Name</label>
                <input type="text" x-model="newProductForm.name" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Product Lock Description</label>
                <textarea x-model="newProductForm.lock" rows="3" placeholder="Exact color, packaging, features..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-pink-500"></textarea>
            </div>
            <div class="flex gap-2 pt-2">
                <button @click="openNewProductModal = false" class="flex-1 bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2.5 rounded-xl text-sm">Cancel</button>
                <button @click="saveProduct()" class="flex-1 bg-pink-600 hover:bg-pink-500 text-white font-bold py-2.5 rounded-xl text-sm">Save Product</button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div x-show="toastMessage" x-transition x-cloak class="fixed top-20 right-4 z-50 bg-pink-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2">
        <i data-lucide="check-circle" class="w-4 h-4"></i>
        <span x-text="toastMessage"></span>
    </div>

    <!-- APPLICATION LOGIC -->
    <script>
        function appData() {
            return {
                currentTab: 'dashboard',
                apiKey: '',
                isGenerating: false,
                toastMessage: '',
                
                navItems: [
                    { id: 'dashboard', name: 'Home', icon: 'home' },
                    { id: 'lazymode', name: 'Lazy Mode', icon: 'zap' },
                    { id: 'videofactory', name: 'Videos', icon: 'clapperboard' },
                    { id: 'hooklab', name: 'Hooks', icon: 'anchor' },
                    { id: 'productvault', name: 'Vault', icon: 'package' }
                ],

                modules: [
                    { id: 'lazymode', name: 'Lazy Mode', desc: 'Upload product & AI does everything.', icon: 'zap' },
                    { id: 'videofactory', name: 'Video Factory', desc: 'Generate AI video concepts & scripts.', icon: 'clapperboard' },
                    { id: 'hooklab', name: 'Hook Lab', desc: '10 scroll-stopping Malaysian hooks.', icon: 'anchor' },
                    { id: 'anglemachine', name: 'Angle Machine', desc: 'Find unique selling angles.', icon: 'compass' },
                    { id: 'productvault', name: 'Product Vault', desc: 'Manage product locks & details.', icon: 'package' }
                ],

                lazyForm: { name: '', imagePreview: '', imageBase64: '', malayStyle: 'Casual Malaysian Malay', videoStyle: 'Problem-Solution' },
                lazyResult: null,

                factoryForm: { product: '', duration: '15 seconds', style: 'Malaysian Comedy Skit' },
                factoryResult: null,

                hookProduct: '',
                hookResults: [],

                angleProduct: '',
                angleResults: [],

                savedProducts: [],
                openNewProductModal: false,
                newProductForm: { name: '', lock: '' },

                init() {
                    this.apiKey = localStorage.getItem('gemini_api_key') || '';
                    const loadedProducts = localStorage.getItem('affiliate_products');
                    if (loadedProducts) {
                        this.savedProducts = JSON.parse(loadedProducts);
                    }
                    this.$watch('currentTab', () => {
                        setTimeout(() => lucide.createIcons(), 50);
                    });
                    setTimeout(() => lucide.createIcons(), 50);
                },

                saveSettings() {
                    localStorage.setItem('gemini_api_key', this.apiKey);
                    this.showToast('API Key saved successfully!');
                },

                showToast(msg) {
                    this.toastMessage = msg;
                    setTimeout(() => { this.toastMessage = ''; }, 3000);
                },

                handleImageUpload(event, type) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        if (type === 'lazy') {
                            this.lazyForm.imagePreview = e.target.result;
                            this.lazyForm.imageBase64 = e.target.result.split(',')[1];
                        }
                    };
                    reader.readAsDataURL(file);
                },

                async callGemini(promptText, base64Image = null) {
                    if (!this.apiKey) {
                        this.currentTab = 'settings';
                        alert('Please enter your Gemini API Key in Settings first!');
                        return null;
                    }

                    const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${this.apiKey}`;
                    
                    let parts = [{ text: promptText }];
                    if (base64Image) {
                        parts.push({
                            inline_data: {
                                mime_type: "image/jpeg",
                                data: base64Image
                            }
                        });
                    }

                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ contents: [{ parts: parts }] })
                        });
                        const data = await response.json();
                        if (data.candidates && data.candidates[0].content) {
                            return data.candidates[0].content.parts[0].text;
                        } else {
                            throw new Error(data.error?.message || 'Failed to generate response from Gemini.');
                        }
                    } catch (err) {
                        alert('Error: ' + err.message);
                        return null;
                    }
                },

                async runLazyMode() {
                    this.isGenerating = true;
                    const prompt = `You are an expert TikTok Affiliate Content Strategist, Scriptwriter, and Veo Prompt Engineer for the Malaysian market.
Product Name: "${this.lazyForm.name}"
Malay Style: "${this.lazyForm.malayStyle}"
Video Style: "${this.lazyForm.videoStyle}"

Return strict JSON format with keys:
- productName (string)
- productLock (string: exact physical description to prevent AI hallucination)
- strategy: { audience, problem, benefit }
- hook (string: scroll-stopping hook in natural Malaysian Malay)
- script (string: dialogue and action for the video)
- veoPrompt (string: professional 9:16 vertical video prompt for Veo including character, setting, lighting, camera movement, product lock)
- caption (string: engaging TikTok caption)
- hashtags (string: relevant hashtags)

Return ONLY valid JSON without markdown formatting blocks if possible, or standard markdown JSON.`;

                    const res = await callGeminiAPI(this.apiKey, prompt, this.lazyForm.imageBase64);
                    this.isGenerating = false;
                    if (res) {
                        try {
                            const cleaned = res.replace(/```json/g, '').replace(/```/g, '').trim();
                            this.lazyResult = JSON.parse(cleaned);
                            this.showToast('Lazy content generated successfully!');
                        } catch (e) {
                            // Fallback parsing if JSON is imperfect
                            this.lazyResult = {
                                productName: this.lazyForm.name,
                                productLock: 'Standard product as described: ' + this.lazyForm.name,
                                strategy: { audience: 'Malaysian TikTok shoppers', problem: 'Daily inconvenience', benefit: 'Easy solution' },
                                hook: 'Eh korang, sedar tak benda ni sebenarnya selamatkan banyak masa?',
                                script: res,
                                veoPrompt: 'Vertical 9:16 cinematic video showing ' + this.lazyForm.name,
                                caption: 'Wajib try ni memang best! Link di bio.',
                                hashtags: '#tiktokmalaysia #affiliatemarketing #' + this.lazyForm.name.replace(/\s+/g, '')
                            };
                        }
                    }
                },

                async runVideoFactory() {
                    this.isGenerating = true;
                    const prompt = `Create a TikTok affiliate video script and concept for product: "${this.factoryForm.product}", Duration: "${this.factoryForm.duration}", Style: "${this.factoryForm.style}". Use natural Malaysian Malay tone. Include Hook, Scene breakdown, Dialogue, and CTA.`;
                    const res = await this.callGemini(prompt);
                    this.isGenerating = false;
                    if (res) {
                        this.factoryResult = { title: this.factoryForm.product + ' (' + this.factoryForm.style + ')', fullText: res };
                    }
                },

                async runHookLab() {
                    this.isGenerating = true;
                    const prompt = `Generate exactly 10 scroll-stopping TikTok hooks for "${this.hookProduct}" in Malaysian Malay. Categorize each into Curiosity, Comedy, Shock, Relatable, or Visual. Give each a Stop-Score out of 10. Return as JSON array of objects with keys: category, text, score.`;
                    const res = await this.callGemini(prompt);
                    this.isGenerating = false;
                    if (res) {
                        try {
                            const cleaned = res.replace(/```json/g, '').replace(/```/g, '').trim();
                            this.hookResults = JSON.parse(cleaned);
                        } catch (e) {
                            this.hookResults = [
                                { category: 'Curiosity', text: 'Kenapa ramai tak tahu trik ni untuk ' + this.hookProduct + '?', score: 9 },
                                { category: 'Relatable', text: 'Bila dah penat dengan cara lama, jumpa jugak benda ni...', score: 8 }
                            ];
                        }
                    }
                },

                async runAngleMachine() {
                    this.isGenerating = true;
                    const prompt = `Generate 10 distinct selling angles for "${this.angleProduct}" (Problem, Convenience, Money, Emotional, Funny, Curiosity, Comparison, Before/After, Lifestyle, Unexpected use). Return as JSON array with keys: title, concept.`;
                    const res = await this.callGemini(prompt);
                    this.isGenerating = false;
                    if (res) {
                        try {
                            const cleaned = res.replace(/```json/g, '').replace(/```/g, '').trim();
                            this.angleResults = JSON.parse(cleaned);
                        } catch (e) {
                            this.angleResults = [{ title: 'Problem Angle', concept: 'Solving the daily hassle instantly.' }];
                        }
                    }
                },

                saveProduct() {
                    if (!this.newProductForm.name) return;
                    const newProd = {
                        id: Date.now(),
                        name: this.newProductForm.name,
                        lock: this.newProductForm.lock || 'Exact product specifications locked.',
                        date: new Date().toLocaleDateString()
                    };
                    this.savedProducts.push(newProd);
                    localStorage.setItem('affiliate_products', JSON.stringify(this.savedProducts));
                    this.newProductForm = { name: '', lock: '' };
                    this.openNewProductModal = false;
                    this.showToast('Product saved to vault!');
                },

                deleteProduct(id) {
                    this.savedProducts = this.savedProducts.filter(p => p.id !== id);
                    localStorage.setItem('affiliate_products', JSON.stringify(this.savedProducts));
                    this.showToast('Product deleted.');
                },

                loadIntoLazy(prod) {
                    this.lazyForm.name = prod.name;
                    this.currentTab = 'lazymode';
                },

                copyText(text) {
                    navigator.clipboard.writeText(text);
                    this.showToast('Copied to clipboard!');
                },

                copyAllContent(res) {
                    const all = `HOOK:\n${res.hook}\n\nSCRIPT:\n${res.script}\n\nVEO PROMPT:\n${res.veoPrompt}\n\nCAPTION:\n${res.caption} ${res.hashtags}`;
                    this.copyText(all);
                }
            }
        }

        async function callGeminiAPI(apiKey, promptText, base64Image) {
            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;
            let parts = [{ text: promptText }];
            if (base64Image) {
                parts.push({ inline_data: { mime_type: "image/jpeg", data: base64Image } });
            }
            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contents: [{ parts: parts }] })
                });
                const data = await response.json();
                if (data.candidates && data.candidates[0].content) {
                    return data.candidates[0].content.parts[0].text;
                } else {
                    throw new Error(data.error?.message || 'API Error');
                }
            } catch (err) {
                alert('Gemini API Error: ' + err.message);
                return null;
            }
        }
    </script>
</body>
</html>
